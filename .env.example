# Copy to .env and fill in. NEVER commit .env.
#
# The defaults are the FREE stack. You need exactly TWO values: the bot token
# and one Groq key. No bank card, and no dependence on Gemini, whose API is
# unavailable in several countries.

# ============================================================
#  REQUIRED — only these two
# ============================================================

# 1. @BotFather -> /mybots -> your bot -> API Token
BOT_TOKEN=

# 2. https://console.groq.com/keys  (free, no card, works worldwide)
#    Covers BOTH speech recognition and dialogue.
#    Free tier: ~8 hours of audio and thousands of requests per day.
GROQ_API_KEY=

# ============================================================
#  FREE DEFAULTS — change nothing and it costs you nothing
# ============================================================

LLM_PROVIDER=groq
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# Switch the assessor to llama-3.1-8b-instant to raise the daily ceiling a lot.
GROQ_ASSESSOR_MODEL=llama-3.3-70b-versatile

STT_PROVIDER=groq

# edge = Microsoft neural voices. No key, no account, no cost.
TTS_PROVIDER=edge

# A local file. Nothing to install, nothing to pay for.
# On hosting with ephemeral disk, point this at Supabase instead (see below).
DB_DSN=sqlite+aiosqlite:///data/speakout.db

# ============================================================
#  PAID / OPTIONAL UPGRADES — leave empty to stay free
# ============================================================

# Google Gemini. Free tier, better dialogue quality than Llama. Set
# LLM_PROVIDER=gemini to use — GROQ_API_KEY is still needed for speech.
# Keys issued since mid-2026 start with "AQ." rather than "AIza"; both work
# here because this talks to the native endpoint, not the OpenAI-compatible
# one, which rejects the newer keys.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_ASSESSOR_MODEL=gemini-2.5-flash

# Claude — the best dialogue and error analysis, and paid.
# Set LLM_PROVIDER=anthropic to use.
ANTHROPIC_API_KEY=
TUTOR_MODEL=claude-opus-5
ASSESSOR_MODEL=claude-opus-5

# Needed only for STT_PROVIDER=openai or TTS_PROVIDER=openai.
OPENAI_API_KEY=

# The most lifelike voices. Set TTS_PROVIDER=elevenlabs to use.
ELEVENLABS_API_KEY=

# Supabase / Postgres instead of SQLite. Use the SESSION-mode pooler (port
# 5432), never transaction mode (6543) — see deploy/KOYEB.md.
# DB_DSN=postgresql+asyncpg://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Only needed before running more than one process.
REDIS_URL=

# ============================================================
#  HOSTING
# ============================================================

# Leave EMPTY to run on your own machine (the bot polls Telegram itself).
#
# Set it to your public https address to switch to webhook mode. Required on
# free hosting that sleeps an idle service, because Telegram's own POST is
# what wakes it back up. Example: https://speakout-you.koyeb.app
WEBHOOK_BASE_URL=

# Optional. Generated randomly each start if empty. Set it if you want the
# webhook to survive a restart without Telegram re-registering.
WEBHOOK_SECRET=

# The port to listen on in webhook mode. Most hosts set this for you.
PORT=8000

# ============================================================
#  Ops
# ============================================================

ADMIN_IDS=
LOG_LEVEL=INFO

# Free tiers have daily ceilings. This stops one enthusiastic user from
# spending the whole day's quota before lunch. 0 = unlimited.
FREE_DAILY_TURNS=40
MAX_VOICE_SECONDS=120
