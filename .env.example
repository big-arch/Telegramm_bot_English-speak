# Copy to .env and fill in. NEVER commit .env.

# --- Telegram ---
# @BotFather -> /mybots -> SpeakOutEducation_bot -> API Token
BOT_TOKEN=

# --- Database (Supabase) ---
# Use the SESSION-mode pooler (port 5432), not transaction mode (6543).
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
# Then swap the scheme to postgresql+asyncpg://
DB_DSN=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- LLM (dialogue + error analysis) ---
ANTHROPIC_API_KEY=
# claude-opus-5 is the most capable. claude-sonnet-5 is ~2.5x cheaper per token
# and a reasonable trade for high volume. Your call — see README "Economics".
TUTOR_MODEL=claude-opus-5
ASSESSOR_MODEL=claude-opus-5

# --- Speech recognition (Whisper) ---
OPENAI_API_KEY=

# --- Text to speech ---
# elevenlabs = better voices, ~6-12x pricier. openai = cheap, decent.
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=

# --- Optional: Redis for FSM + cache. Leave empty to run without it. ---
REDIS_URL=

# --- Ops ---
# Comma-separated Telegram user ids that can run /admin
ADMIN_IDS=
LOG_LEVEL=INFO

# --- Economics guardrails (see README) ---
# Daily cap per user on voice turns. 0 = unlimited.
FREE_DAILY_TURNS=0
# Hard ceiling on a single voice message, seconds.
MAX_VOICE_SECONDS=120
